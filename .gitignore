# ---- 构建产物 ----
# build/ 本身要入库：build/windows/ 放 Wails 平台资源（VERSIONINFO 源、应用清单）。
# 只忽略真正的产物与临时报告。
build/bin/
build/a11y_audit.json
build/verify_trim.txt
# 截图 / 审计临时报告（scripted 探针跑一回就变一次，不入库）
build/shots/
release/
*.exe

# ---- Node 依赖（仅渲染层探针用 Playwright，验证工具，非产品依赖）----
node_modules/

# ---- Python 缓存（scripts/ 下的验证脚本）----
__pycache__/
*.pyc

# ---- 本地工具数据（项目记忆 / 技能，不入库）----
.workbuddy/

# ---- 运行时数据（便携运行会落在 exe 旁，不入库）----
# 注意：assets/sounds/ 是内置提示音**源文件**（打包预置用），要入库；
# 运行时的用户音频副本在 config/sounds/，被上面的 config/ 覆盖。
config/
data/
stats.json

# ---- 日志与临时 ----
*.log
*.tmp
*.bak
*.orig
*~

# ---- 运营素材（网站 / 推广用，不随软件分发）----
docs/promo/

# ---- 编辑器与系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
