# ---- 构建产物 ----
build/
release/
*.exe

# ---- Node 依赖（仅渲染层探针用 Playwright，验证工具，非产品依赖）----
node_modules/

# ---- Python 缓存（scripts/ 下的验证脚本）----
__pycache__/
*.pyc

# ---- 本地工具数据（项目记忆 / 技能，不入库）----
.workbuddy/

# ---- 运行时数据（便携运行会落在 exe 旁，不入库）----
config/
stats.json
sounds/

# ---- 日志与临时 ----
*.log
*.tmp
*.bak
*.orig
*~

# ---- 编辑器与系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
